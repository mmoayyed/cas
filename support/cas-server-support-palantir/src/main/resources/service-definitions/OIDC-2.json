{
  "@class": "org.apereo.cas.services.OidcRegisteredService",
  "clientId": "...",
  "clientSecret": "...",
  "serviceId": "^https://app\\.example\\.org/callback",
  "name": "Release claims regardless of scopes",
  "description": "The authorization code and client credentials flows, with an attribute release policy that decides the claims instead of the scopes.",
  "attributeReleasePolicy": {
    "@class": "org.apereo.cas.services.ReturnMappedAttributeReleasePolicy",
    "allowedAttributes": {
      "@class": "java.util.TreeMap",
      "membership": "groups",
      "given_name": "givenName",
      "family_name": "sn"
    }
  },
  "supportedGrantTypes": [
    "java.util.HashSet",
    [
      "authorization_code",
      "client_credentials"
    ]
  ],
  "supportedResponseTypes": [
    "java.util.HashSet",
    [
      "code"
    ]
  ],
  "scopes": [
    "java.util.HashSet",
    [
      "openid"
    ]
  ]
}
