    "java.util.HashSet",
    [
      "code"
    ]
  ],
  "supportedGrantTypes": [
    "java.util.HashSet",
    [
      "authorization_code"
    ]
  ],
  "scopes": [
    "java.util.HashSet",
    [
      "openid",
      "profile"
    ]
  ]
}
