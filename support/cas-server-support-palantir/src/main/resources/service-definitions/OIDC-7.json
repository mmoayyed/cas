{
  "@class": "org.apereo.cas.services.OidcRegisteredService",
  "clientId": "...",
  "clientSecret": "...",
  "serviceId": "^https://app\\.example\\.org/callback",
  "name": "Encrypted ID tokens",
  "description": "Signs ID tokens with RS256 and encrypts them with a key from the client's JWKS.",
