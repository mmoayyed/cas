{
  "@class": "org.apereo.cas.support.saml.services.SamlRegisteredService",
  "serviceId": ".+",
  "name": "InCommon MDQ with R&S",
  "description": "Fetches each service provider's metadata from InCommon's MDQ service, verifies its signature, and releases the Research and Scholarship bundle where it applies.",
  "metadataSignatureLocation": "file:/etc/cas/saml/inc-md-cert-mdq.pem",
  "metadataLocation": "http://mdq.incommon.org/entities/{0}",
  "attributeReleasePolicy": {
    "@class": "org.apereo.cas.services.ChainingAttributeReleasePolicy",
    "policies": [
      "java.util.ArrayList",
      [
        {
          "@class": "org.apereo.cas.support.saml.services.InCommonRSAttributeReleasePolicy"
        }
      ]
    ]
  }
}
