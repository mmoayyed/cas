{
  "@class": "org.apereo.cas.support.saml.services.SamlRegisteredService",
  "serviceId": "https://sp.example.org/shibboleth",
  "name": "Metadata from a file",
  "description": "Reads the service provider's metadata from a local XML file and releases only mail and uid.",
  "metadataLocation": "file:/etc/cas/saml/sp-metadata.xml",
  "attributeReleasePolicy": {
    "@class": "org.apereo.cas.services.ReturnAllowedAttributeReleasePolicy",
    "allowedAttributes": [
      "java.util.ArrayList",
      [
        "mail",
        "uid"
      ]
    ],
    "authorizedToReleaseAuthenticationAttributes": false
  }
}
